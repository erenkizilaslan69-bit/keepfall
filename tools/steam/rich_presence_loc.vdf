"lang"
{
	// Steamworks partner site -> Community & Marketing -> Rich Presence: upload this file. The game sets the key "steam_display" to one of the tokens
	// (client/src/steam.ts, SteamStatus); Steam shows the text in each friend's own language.
	"english"
	{
		"tokens"
		{
			"#Status_Menu"          "In the main menu"
			"#Status_Lobby"         "In a lobby {%players%} ({%mode%} min)"
			"#Status_Prep"          "Preparing the castle ({%mode%} min)"
			"#Status_War"           "At war ({%mode%} min)"
			"#Status_ChallengePrep" "Challenge: preparing the castle"
			"#Status_ChallengeWar"  "Challenge: at war"
			"#Status_Spectating"    "Watching the battle (castle fallen)"
			"#Status_Ended"         "Looking at the match result"
		}
	}
	"turkish"
	{
		"tokens"
		{
			"#Status_Menu"          "Ana menüde"
			"#Status_Lobby"         "Lobide {%players%} ({%mode%} dk)"
			"#Status_Prep"          "Kalesini hazırlıyor ({%mode%} dk)"
			"#Status_War"           "Savaşta ({%mode%} dk)"
			"#Status_ChallengePrep" "Meydan Okuma: kalesini hazırlıyor"
			"#Status_ChallengeWar"  "Meydan Okuma: savaşta"
			"#Status_Spectating"    "Savaşı izliyor (kalesi düştü)"
			"#Status_Ended"         "Maç sonucuna bakıyor"
		}
	}
}
