# Used by `vite build --mode steam` (the offline Steam demo, tools/pack-steam.mjs). The page is served by the bundled local game server,
# so there is no server address; private rooms (multiplayer) are closed, the Steam bridge is looked for in the desktop shell.
VITE_PLATFORM=steam
VITE_FEATURE_PRIVATE_ROOM=0
VITE_FEATURE_CRAZY_INVITE=0
