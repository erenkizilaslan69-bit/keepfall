# Used by `vite build --mode steam` (the offline Steam demo, tools/pack-steam.mjs). The page is served by the bundled local game server,
# so there is no server address; the Steam bridge is looked for in the desktop shell. Rooms for friends are open: the player who makes one is the
# server (friend-hosted, client/src/hosted.ts + tools/steam/shell/mp.js); there is no official server.
VITE_PLATFORM=steam
VITE_FEATURE_PRIVATE_ROOM=1
VITE_FEATURE_CRAZY_INVITE=0
