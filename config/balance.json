// Keepfall denge ayarları (v1 — denge v1) — kaynak: docs/kale_oyunu_sayilar.xlsx
// Ekonomi: ilk oyun testinden sonra Excel'den ayrıştı (başlangıç odun/demir, çiftçi üretimi, yükseltme maliyetleri).
// Bu dosya yorum satırlarına izin verir. Sayıları değiştir, BattleSim'i tekrar çalıştır.
{
  // Excel "Maç" sekmesi.
  "match": {
    // Maç süresinin hazırlığa ayrılan payı. Hazırlık = round(mod dakikası × oran) dakika (15 dk → 5 dk).
    "prepRatio": 0.33,
    "shortModeMinutes": 15,
    "longModeMinutes": 30,
    // Sunucu bu aralıkla tick atar (sn); üretim ve tüketim her tick'te hesaplanır.
    "serverTickSeconds": 1,
    "startingPopulation": 10,
    "startingResources": { "food": 30, "wood": 40, "iron": 20 }
  },

  // Excel "Ekonomi" sekmesi.
  "economy": {
    // Kişi başı dakikada üretim (çiftçi → yemek, oduncu → odun, madenci → demir).
    // Birlik maliyetini "odun karşılığına" çevirmek için de kullanılır.
    "productionPerMinute": { "food": 8, "wood": 5, "iron": 4 },
    "workerFoodPerMinute": 1,
    "soldierFoodPerMinute": 1.5,
    // Yemek 0'a düşerse tüm üretim bu çarpanla çalışır.
    "starvationMultiplier": 0.5,
    // Yeni kişi maliyeti = newPersonBaseCost × (1 + newPersonCostGrowth) ^ (nüfus − newPersonBasePopulation), yuvarlanır.
    "newPersonBaseCost": 15,
    "newPersonCostGrowth": 0.12,
    "newPersonBasePopulation": 10,
    // Otomatik büyüme bu kadar saniyelik yemek tüketimini rezerv olarak bırakır:
    // yeni kişi, maliyeti düşüldükten sonra elde en az (dakikalık tüketim × süre / 60) yemek kalıyorsa doğar.
    "growthReserveSeconds": 60
  },

  // Excel "Maç" sekmesi: gözcü.
  "scouting": {
    // Gidiş + dönüş (sn). Görevdeki gözcü çalışmaz ama yemek yer; görev bitince boşta döner.
    "missionSeconds": 45,
    // Gözcü hedefe görevin bu kesrinde varır; rapor o an hesaplanır, dönüşte teslim edilir.
    "arrivalFraction": 0.5,
    // Asker sayıları bu oranda (±), ama en az ±1 asker hatalı görünür; türler ve bina seviyeleri kesin
    // (asker yoksa 0, varsa en az 1 görünür).
    "reportError": 0.2
  },

  // Excel "Binalar" sekmesi: tarla, oduncu kampı, maden ve demirhane aynı tabloyu kullanır.
  // Sıra = seviye (ilki seviye 1). upgrade* = o seviyeye çıkmanın maliyeti ve süresi (sn).
  // Demirhanede multiplier = silah üretim hızı.
  "buildingLevels": [
    { "capacity": 4, "multiplier": 1.0, "upgradeWood": 0,  "upgradeIron": 0,  "upgradeSeconds": 0 },
    { "capacity": 6, "multiplier": 1.5, "upgradeWood": 20, "upgradeIron": 10, "upgradeSeconds": 30 },
    { "capacity": 8, "multiplier": 2.0, "upgradeWood": 40, "upgradeIron": 25, "upgradeSeconds": 60 }
  ],

  "combat": {
    // Simülasyon adımı (sn). Küçüldükçe daha hassas, daha yavaş.
    "tickSeconds": 0.1,
    // Bu süreyi geçen savaş berabere sayılır.
    "maxBattleSeconds": 600,
    // true: her birliğin ilk vuruşu 0..saldırı aralığı arasında rastgele bir anda gelir
    // (herkesin aynı anda vurmasını engeller). false: herkes ilk vuruşu hemen yapar.
    "randomizeFirstAttack": true,
    // Savaş başında yakın dövüşçülerin hedefe ulaşma süresi (sn). Bu sürede sadece okçular vurur.
    "approachTime": 2.5,

    // Karşılık matrisindeki "+", "-", "=" sembollerinin değeri.
    "advantageMultiplier": 1.5,
    "disadvantageMultiplier": 0.75,
    "neutralMultiplier": 1.0
  },

  // range: "melee" (yakın) | "ranged" (uzak)
  // row:   "front" (ön) | "back" (arka). Arka sıra, kendi ön sırası düşene kadar hasar almaz.
  //        Arka sıradaki yakın dövüşçüler yedektir: ön sıra düşünce öne çıkar.
  "units": [
    {
      "id": "okcu", "name": "Okçu", "phase": 1,
      "cost": { "iron": 1, "wood": 4, "food": 0, "people": 1 },
      "buildSeconds": 25,
      "hp": 70, "damage": 11, "attackInterval": 1.2,
      "range": "ranged", "row": "back"
    },
    {
      "id": "kilicli", "name": "Kılıçlı", "phase": 1,
      "cost": { "iron": 3, "wood": 2, "food": 0, "people": 1 },
      "buildSeconds": 30,
      "hp": 100, "damage": 8.5, "attackInterval": 1.0,
      "range": "melee", "row": "front"
    },
    {
      "id": "mizrakci", "name": "Mızrakçı", "phase": 1,
      "cost": { "iron": 1, "wood": 3, "food": 0, "people": 1 },
      "buildSeconds": 20,
      "hp": 90, "damage": 11, "attackInterval": 1.2,
      "range": "melee", "row": "front"
    },
    {
      "id": "kalkanli", "name": "Kalkanlı", "phase": 1,
      "cost": { "iron": 2, "wood": 3, "food": 0, "people": 1 },
      "buildSeconds": 35,
      "hp": 150, "damage": 7, "attackInterval": 1.3,
      "range": "melee", "row": "front"
    }
  ],

  // Saldıran (satır) -> savunan (sütun) hasar çarpanı.
  // "+" = avantaj, "-" = dezavantaj, "=" = nötr, ya da doğrudan bir sayı (ör. 1.2).
  // Yazılmayan eşleşmeler nötr sayılır.
  "counters": {
    "okcu":     { "okcu": "=", "kilicli": "+", "mizrakci": "=", "kalkanli": 0.6 },
    "kilicli":  { "okcu": "-", "kilicli": "=", "mizrakci": "+", "kalkanli": "=" },
    "mizrakci": { "okcu": "=", "kilicli": "-", "mizrakci": "=", "kalkanli": "+" },
    "kalkanli": { "okcu": "=", "kilicli": "=", "mizrakci": "-", "kalkanli": "=" }
  }
}
