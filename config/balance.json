// Keepfall denge ayarları (v1 — denge v1) — kaynak: docs/kale_oyunu_sayilar.xlsx
// Ekonomi: ilk oyun testinden sonra Excel'den ayrıştı (başlangıç odun/demir, çiftçi üretimi, yükseltme maliyetleri).
// Bu dosya yorum satırlarına izin verir. Sayıları değiştir, BattleSim'i tekrar çalıştır.
{
  // Excel "Maç" sekmesi.
  "match": {
    // Mod süresi ve bunun hazırlığa ayrılan kısmı (dk). Savaş = mod − hazırlık (20 dk → 10 + 10, 30 dk → 20 + 10).
    "shortModeMinutes": 20,
    "shortModePrepMinutes": 10,
    "longModeMinutes": 30,
    "longModePrepMinutes": 20,
    // Sunucu bu aralıkla tick atar (sn); üretim ve tüketim her tick'te hesaplanır.
    "serverTickSeconds": 1,
    // Elenen oyuncu önce spectatorWaitSeconds oyun saniyesi süren bir geçiş ekranı görür, sonra tüm haritayı (sissiz)
    // spectatorDelaySeconds oyun saniyesi gecikmeyle izler; 0 = canlı.
    "spectatorWaitSeconds": 5,
    // Son insan elenip botlar oynamaya devam ediyorsa maç en az bu kadar oyun saniyesi daha sürer; oda sahibi bu sürede "İzlemeye devam" ya da "Maçı bitir" seçer.
    "spectatorMinSeconds": 120,
    // Bir işçiyi askere çevirmek (silah kuşanmak) bu kadar saniye sürer: bu sürede ne çalışır ne savaşır; 0 = anında. Kullanıcı kararı: 15. Paralı asker her zaman anında.
    "armSeconds": 15,
    "spectatorDelaySeconds": 0,
    "startingPopulation": 12,
    "startingResources": { "food": 30, "wood": 40, "iron": 20 }
  },

  // Excel "Ekonomi" sekmesi.
  "economy": {
    // Kişi başı dakikada üretim (çiftçi → yemek, oduncu → odun, madenci → demir).
    // Birlik maliyetini "odun karşılığına" çevirmek için de kullanılır.
    "productionPerMinute": { "food": 8, "wood": 5, "iron": 4 },
    "workerFoodPerMinute": 1,
    "soldierFoodPerMinute": 1.5,
    // Yemek 0'a düşerse tüm üretim bu çarpanla çalışır.
    "starvationMultiplier": 0.5,
    // Yeni kişi maliyeti = newPersonBaseCost × (1 + newPersonCostGrowth) ^ (nüfus − newPersonBasePopulation), yuvarlanır.
    "newPersonBaseCost": 15,
    "newPersonCostGrowth": 0.08,
    "newPersonBasePopulation": 10,
    // Otomatik büyüme bu kadar saniyelik yemek tüketimini rezerv olarak bırakır:
    // yeni kişi, maliyeti düşüldükten sonra elde en az (dakikalık tüketim × süre / 60) yemek kalıyorsa doğar.
    "growthReserveSeconds": 60
  },

  // Ortak harita: ordular ve gözcüler yollarda bu hızla yürür (karo/sn). Yolculuk süresi = yol uzunluğu / hız.
  // Standart haritada komşu kaleye yol 56 karo, çapraz kaleye (ormanın içinden) yaklaşık 64 karo.
  "map": {
    "armySpeed": 1.5,
    "scoutSpeed": 2.5,
    // Gözcünün yürüdüğü yolun çevresi (görüş yarıçapı kadar) geçtikten sonra bu kadar saniye canlı görüşte kalır
    // (son 10 sn soluklaşır); 0 = maç sonuna kadar. Rakibin kale bölgesinin içini açmaz.
    "scoutTrailSeconds": 60,
    // Savaş sisi: oyuncu sadece bu yarıçaplar (karo) içindekileri görür; gerisi sunucudan hiç gelmez.
    // Kale görüşü kapıdan ölçülür; düşman ordusu buna girince "X'den bir ordu yaklaşıyor!" uyarısı çıkar
    // (komşudan gelen ordu için varıştan ~18 sn, çaprazdan ~17 sn önce).
    "vision": { "castle": 20, "army": 6, "scout": 10 }
  },

  // Excel "Maç" ve "Binalar" sekmeleri: savaş fazı. Savaş süresi = mod süresi − hazırlık (20 dk → 10 dk).
  "war": {
    // Kıtlık: savaş başladıktan famineStartSeconds sn sonra yemek üretimi bu çarpanla çalışır ve maç sonuna kadar sürer.
    // (famineStartSeconds negatifse savaşın famineStart oranından sonra başlar.)
    "famineStart": 0.7,
    "famineStartSeconds": 240,
    "famineFoodMultiplier": 0.5,
    // Savaşlar görünür ve gerçek zamanlı: simülasyonun her saniyesi oyunda 1 / battlePlayback saniye sürer.
    // Kalede: kapıda savaş; saldıran kazanırsa (tek asker kalsa bile) kale düşer. Sonuçlar savaş bitince uygulanır.
    "battlePlayback": 0.75,
    // Farklı oyunculara ait iki ordu yolda bu kadar (karo) yaklaşırsa durup savaşır (kavşaklar dahil).
    // Süren bir yol savaşına bu mesafenin 1,5 katından fazla yaklaşamayan üçüncü ordular bekler.
    "encounterRadius": 1.0,
    // Kale düşünce düşüren oyuncu (askerleriyle birlikte eve dönerken) düşen kalenin depodaki yemek, odun, demir ve altınının
    // fallLootShare kadarını alır; hayatta kalan işçilerin fallWorkerShare kadarı boşta olarak ona katılır.
    "fallLootShare": 0.5,
    "fallWorkerShare": 0.3333,
    // Kale düşünce kapıda savaşan savunan ordunun bu kadarı (yarısı) saldıranın askeri olur (esir): türleri korunur, orduyla eve gelir.
    "prisonerShare": 0.5,
    // Yalnız baskıncılardan (süvari) oluşan ordu kapıda kazanırsa kale düşmez; tarlalar yanar: yemek üretimi raidBurnSeconds sn boyunca raidBurnFactor katı.
    "raidBurnSeconds": 60,
    "raidBurnFactor": 0.5
  },

  // Altın (ormandan gelir: sandık, köy, haydut kampı): kale penceresinde birim başına bu fiyata anında asker kiralanır.
  // Paralı asker işçiden düşmez, nüfusa sayılır ve yemek yer (askerlik yemeği); işçiye dönüştürülemez.
  // Fiyat ~ silahın odun karşılığı (demir ≈ 1,25 odun) + yeni bir kişinin yemek bedeli (~12 odun), altın ≈ 1,4 odun.
  "mercenary": {
    "okcu": 26,
    "mizrakci": 24,
    "kilicli": 29,
    "kalkanli": 33,
    "kesis": 28,
    "mancinik": 55,
    "suvari": 40
  },

  // Orman: her köşe kendi çeyreğinde aynı sayıda ve türde nokta alır (her maç rastgele ama adil: her yuva için tek bir
  // yol uzaklığı çekilir, her köşe aynı uzaklığı kullanır, yalnız patikanın yolun hangi yanına döneceği köşeye göre değişir);
  // ormanın tam ortasında büyük kamp durur. Noktalar yoldan patikalarla ayrılır; patikalar keşfedilene kadar kimseye bildirilmez.
  "forest": {
    "chestsPerCorner": 2,
    "villagesPerCorner": 1,
    "campsPerCorner": 1,
    // Noktalar arası en az karo; ortadaki büyük kampa en az karo; orman yolunda patikanın ayrıldığı yer (kavşaktan karo);
    // patika uzunluğu; ring yoluna bırakılan boşluk.
    "minSpacing": 3.5,
    "hubClearing": 2.5,
    "footMin": 2, "footMax": 11.5,
    "spurMin": 1.5, "spurMax": 4.5,
    "edgeMargin": 1.5,
    // Bir çeyreği keşfeden gözcü, o çeyreğin noktalarına bu kadar karo yaklaşınca onları bulur (patika uzunluğundan büyük olmalı).
    "discoverRadius": 5,
    "chest": { "goldMin": 30, "goldMax": 45, "ironMin": 4, "ironMax": 8 },
    "village": { "goldMin": 20, "goldMax": 30, "foodMin": 14, "foodMax": 24, "peopleMin": 2, "peopleMax": 4, "minSoldiers": 3 },
    // Haydutlar birim istatistikleriyle savaşır (id: sayı). Silahlar kazanana hazır silah olarak depoya gider.
    "camp": { "bandits": { "kilicli": 6, "okcu": 1 }, "goldMin": 40, "goldMax": 60, "woodMin": 15, "woodMax": 25, "weapons": { "kilicli": 2, "okcu": 1 } },
    "bigCamp": { "bandits": { "kilicli": 8, "kalkanli": 4, "okcu": 4 }, "goldMin": 154, "goldMax": 210, "weapons": { "kilicli": 3, "mizrakci": 2, "okcu": 1 } }
  },

  // Botlar (oda sahibi lobide ekler). Süreler OYUN saniyesidir (hız ×N olunca botlar da aynı oranda hızlanır).
  // think: bot bu aralıkta bir süre bekleyip yeniden düşünür. react: yeni bir olayı (ordu uyarısı, rapor) bu kadar gecikmeyle fark eder.
  // commands: bir düşünmede en fazla bu kadar komut verir.
  // mistake: her düşünmede aklının bir kısmının şaşırma ihtimali (işi atlar ya da yanlış yapar). slack: kaç kişinin yanlış meslekte durmasına izin verir.
  // mix: botun kurduğu ordunun birim payları. weaponsFrom: hazırlığın bu oranından sonra silah dövmeye başlar.
  // armFrom: hazırlığın bu oranından sonra depodaki silahları askere çevirir (savaşta hepsini).
  // armyShare: nüfusunun en çok bu kadarını asker yapar (gerisi yemek ve silah üretiminde çalışır).
  "bots": {
    // Kolay: ekonomide neredeyse Orta kadar düzgün (ecoMistake, slack, orman/üretim yetenekleri), hesaplı saldırı/kamp kararı açık;
    // zayıflığı hızı (düşünme 7–12 sn, tepki 8–15 sn) ve taktik hata oranı (mistake). Ölçüm: karışık maçta Orta ≈%80 kazanır.
    "easy":   { "thinkMin": 7, "thinkMax": 12, "reactMin": 8, "reactMax": 15, "commands": 2, "mistake": 0.25, "slack": 1,
                "ecoMistake": 0.08, "exploreAll": true, "chestsAnywhere": true, "scouts": 2, "mercBatch": 3, "mercThreatBatch": 6,
                "saves": true, "queueDepth": 3, "calculates": true },
    // scoreAware: bot zafer puanı gibi oynar (hasar, öldürme, eleme; savaşın ilk saniyesinden cesur). Oyun kuralını (nüfus) değiştirmez, yalnız botun saldırı isteğini artırır; Orta'da açık.
    "medium": { "thinkMin": 2, "thinkMax": 3,  "reactMin": 3, "reactMax": 6,  "commands": 4, "mistake": 0.05, "slack": 1, "scoreAware": true },
    // Zor: hile yok (aynı görünümler, aynı komutlar); fark karar kalitesi. Hızlı düşünür ve tepki verir, boşta işçi bırakmaz, yükseltmeyi erken başlatır,
    // rakip raporlarına göre karşı birlik üretir (counterUnits), silahları depoda tutup (holdWeapons) saldırı gelince ya da saldırırken kuşanır,
    // rakiplerin zayıfladığı anı kollar (opportunist) ve gözcü raporlarını taze tutar (scoutFactor).
    "hard":   { "thinkMin": 0.7, "thinkMax": 1.2, "reactMin": 1, "reactMax": 2, "commands": 6, "mistake": 0, "slack": 0, "ecoMistake": 0, "scoreAware": true, "queueDepth": 4, "holdWeapons": true, "counterUnits": true, "opportunist": true, "scoutFactor": 0.5, "upgradeEarly": true, "foresight": true, "garrisonShare": 0.2 },
    // Ulakla gelen hediyenin (yük toplamı) bu eşikten fazlasını alan bot, gönderen oyuncuya bu kadar saniye saldırmaz (mesajı yok sayar). Botlar ulak göndermez.
    "giftThreshold": 30,
    "giftPeaceSeconds": 90,
    // Ordu karışımı payları; bot yalnız destesindeki birimleri kullanır, paylar deste içinde yeniden oranlanır.
    "mix": { "kilicli": 0.3, "kalkanli": 0.2, "okcu": 0.2, "mizrakci": 0.2, "kesis": 0.08, "mancinik": 0.08, "suvari": 0.15 },
    // Orta ve Zor botların seçtiği desteler (kolay bot rastgele seçer). Ölçümle belirlenir.
    "decks": [
      ["okcu", "kalkanli", "kesis", "suvari"],
      ["okcu", "kilicli", "kalkanli", "kesis"],
      ["okcu", "kalkanli", "kesis", "mancinik"],
      ["okcu", "mizrakci", "kalkanli", "mancinik"],
      ["okcu", "mizrakci", "kalkanli", "kesis"],
      ["kilicli", "kalkanli", "kesis", "suvari"],
      ["okcu", "kilicli", "kalkanli", "suvari"]
    ],
    "weaponsFrom": 0.3,
    "armFrom": 0.75,
    "armyShare": 0.5,
    // Saldırı kararı: iyi bot rakibin son rapordaki gücünün attackMargin katını bekler ve ordusu hesaplanan savaşların en az attackRate kadarını kazanıyorsa gider
    // (savaş ilerledikçe ikisi de gevşer).
    "attackMargin": 1.2,
    "attackRate": 0.85,
    // Hazırlığın bu oranına kadar botlar yalnız kendi orman çeyreklerinde gezer ve yağmalar (ortadaki büyük kamp ve başka çeyrekler sonra).
    "otherQuartersFrom": 0.5,
    // Orta bot bir rapora (ya da kapıda dövüştüğü son kuşatmaya) en çok staleReportSeconds saniye güvenir. Eskiyse ya da hiç yoksa,
    // son bildiğiyle (hiç yoksa kendi ordusunun blindRivalShare katını rakip sanarak) yine saldırabilir, ama beklediği düşman
    // (1 + blindMargin) kat büyük sayılır.
    "staleReportSeconds": 160,
    "blindMargin": 1.05,
    "blindRivalShare": 0.8,
    // Savaşın bu kadar ilk saniyesinde körlemesine saldırmaz; önce rapor almaya çalışır.
    "blindAfterWarSeconds": 60
  },

  // Excel "Maç" sekmesi: gözcü.
  // Gözcü hedefin kapısına yürür, raporu orada alır ve eve dönünce teslim eder.
  // Görevdeki gözcü çalışmaz ama yemek yer; dönünce boşta olur.
  "scouting": {
    // Asker sayıları bu oranda (±), ama en az ±1 asker hatalı görünür; türler ve bina seviyeleri kesin
    // (asker yoksa 0, varsa en az 1 görünür).
    "reportError": 0.2,
    // Bir oyuncunun aynı anda en fazla bu kadar gözcüsü olur (kale gözetleme, çeyrek keşfi ve sandık gözcüsü hepsi sayılır); gözcü dönmeden yenisi çıkamaz.
    "maxScouts": 1,
    // Hazırlığın son bu kadar saniyesinde hiçbir gözcü gönderilemez (rakip, orman keşfi, sandık; botlar da); 0 = hep serbest. Savaş başlayınca hazırlıkta açılan tüm gözcü izleri kapanır.
    "noScoutLastPrepSeconds": 60
  },

  // Sur: kale canı yok; sur hep en üst seviye görünümünde durur. Saldıran kapıdaki savaşı kazanırsa kale düşer.
  // archerDefenseBonus: kapıyı savunan okçular surun arkasından bu kadar fazla hasar verir (0,25 = +%25).
  // Deste: maç başında her oyuncu birliklerden size tanesini seçer; yalnız onları üretebilir, kuşanabilir, kiralayabilir.
  // Rakibin destesi yalnız gözcü raporunda görünür.
  "deck": { "enabled": true, "size": 4 },

  "walls": {
    "archerDefenseBonus": 0.25
  },

  // Ulak: bir rakip kaleye yemek, odun, demir, altın ve/veya kısa bir mesaj taşır. Gözcüyle aynı hakkı (maxScouts) ve hızı kullanır, bilgi toplamaz,
  // yakalanamaz, hazırlık sonu gözcü yasağına tabi değildir. Yük gönderilirken kasadan düşer, varınca alıcıya girer.
  "envoy": {
    // Bir ulağın taşıyabileceği toplam yük (yemek + odun + demir + altın).
    "maxCargo": 40,
    // Mesajın en uzun hali (karakter); denetim karakteri içeremez.
    "maxMessageLength": 140,
    // Kısa bir küfür listesi yıldızla maskelenir (Türkçe + İngilizce). Varsayılan kapalı.
    "profanityFilter": false
  },

  // Excel "Binalar" sekmesi: tarla, oduncu kampı, maden ve demirhane aynı tabloyu kullanır.
  // Sıra = seviye (ilki seviye 1). upgrade* = o seviyeye çıkmanın maliyeti ve süresi (sn). Süreler yarıya indirildi; Sv4 eklendi (2026-10-27 gece).
  // Demirhanede multiplier = silah üretim hızı.
  "buildingLevels": [
    { "capacity": 4, "multiplier": 1.0, "upgradeWood": 0,  "upgradeIron": 0,  "upgradeSeconds": 0 },
    { "capacity": 6, "multiplier": 1.5, "upgradeWood": 20, "upgradeIron": 10, "upgradeSeconds": 15 },
    { "capacity": 8, "multiplier": 2.0, "upgradeWood": 40, "upgradeIron": 25, "upgradeSeconds": 30 },
    { "capacity": 10, "multiplier": 2.5, "upgradeWood": 80, "upgradeIron": 50, "upgradeSeconds": 60 }
  ],

  "combat": {
    // Simülasyon adımı (sn). Küçüldükçe daha hassas, daha yavaş.
    "tickSeconds": 0.1,
    // Bu süreyi geçen savaş berabere sayılır.
    "maxBattleSeconds": 600,
    // true: her birliğin ilk vuruşu 0..saldırı aralığı arasında rastgele bir anda gelir
    // (herkesin aynı anda vurmasını engeller). false: herkes ilk vuruşu hemen yapar.
    "randomizeFirstAttack": true,
    // Savaş başında yakın dövüşçülerin hedefe ulaşma süresi (sn). Bu sürede sadece okçular vurur.
    "approachTime": 2.5,

    // Karşılık matrisindeki "+", "-", "=" sembollerinin değeri.
    "advantageMultiplier": 1.5,
    "disadvantageMultiplier": 0.75,
    "neutralMultiplier": 1.0
  },

  // range: "melee" (yakın) | "ranged" (uzak)
  // row:   "front" (ön) | "back" (arka). Arka sıra, kendi ön sırası düşene kadar hasar almaz.
  //        Arka sıradaki yakın dövüşçüler yedektir: ön sıra düşünce öne çıkar.
  "units": [
    {
      "id": "okcu", "name": "Okçu", "phase": 1,
      "cost": { "iron": 1, "wood": 4, "food": 0, "people": 1 },
      "buildSeconds": 25,
      "hp": 65, "damage": 9.5, "attackInterval": 1.2,
      "range": "ranged", "row": "back"
    },
    {
      "id": "kilicli", "name": "Kılıçlı", "phase": 1,
      "cost": { "iron": 3, "wood": 2, "food": 0, "people": 1 },
      "buildSeconds": 30,
      "hp": 110, "damage": 9.5, "attackInterval": 1.0,
      "range": "melee", "row": "front"
    },
    {
      "id": "mizrakci", "name": "Mızrakçı", "phase": 1,
      "cost": { "iron": 1, "wood": 3, "food": 0, "people": 1 },
      "buildSeconds": 20,
      "hp": 90, "damage": 10, "attackInterval": 1.2,
      "range": "melee", "row": "front"
    },
    {
      "id": "kalkanli", "name": "Kalkanlı", "phase": 1,
      "cost": { "iron": 2, "wood": 3, "food": 0, "people": 1 },
      "buildSeconds": 35,
      "hp": 135, "damage": 7, "attackInterval": 1.3,
      "range": "melee", "row": "front"
    },
    // Yeni birlikler (2026-10-28 gece, ilk öneri; BattleSim ile kalibre edilir).
    // Keşiş: saldırmaz; her healInterval sn'de kendi ordusunda canı oranca en düşük müttefike heal can verir.
    {
      "id": "kesis", "name": "Keşiş", "phase": 1,
      "cost": { "iron": 1, "wood": 4, "food": 0, "people": 1 },
      "buildSeconds": 30,
      "hp": 60, "damage": 0, "attackInterval": 1.5,
      "range": "ranged", "row": "back",
      "heal": 8, "healInterval": 2.0
    },
    // Mancınık: hep düşmanın arka sırasına vurur (yoksa ön sıraya), asıl hedefe tam, aynı sıradan splashTargets kişiye splashFactor kadar.
    // people 2: kuşanırken iki işçi harcar (işçiye dönerken iki işçi geri gelir).
    {
      "id": "mancinik", "name": "Mancınık", "phase": 1,
      "cost": { "iron": 2, "wood": 5, "food": 0, "people": 2 },
      "buildSeconds": 60,
      "hp": 50, "damage": 28, "attackInterval": 3.0,
      "range": "ranged", "row": "back",
      "splashTargets": 2, "splashFactor": 0.5, "backFirst": true
    },
    // Süvari: yakın dövüş, arka sıradaki okçu/mancınık/keşiş yaşadıkça onlara vurur (flank); haritada speedFactor kat hızlı.
    {
      "id": "suvari", "name": "Süvari", "phase": 1,
      "cost": { "iron": 3, "wood": 4, "food": 0, "people": 1 },
      "buildSeconds": 45,
      "hp": 90, "damage": 9, "attackInterval": 1.0,
      "range": "melee", "row": "front",
      "flank": true, "speedFactor": 2, "raider": true
    }
  ],

  // Saldıran (satır) -> savunan (sütun) hasar çarpanı.
  // "+" = avantaj, "-" = dezavantaj, "=" = nötr, ya da doğrudan bir sayı (ör. 1.2).
  // Yazılmayan eşleşmeler nötr sayılır.
  "counters": {
    "okcu":     { "okcu": "=", "kilicli": "+", "mizrakci": "=", "kalkanli": 0.6, "kesis": "+", "mancinik": "=", "suvari": 0.75 },
    "kilicli":  { "okcu": "-", "kilicli": "=", "mizrakci": "+", "kalkanli": "=", "kesis": "+", "mancinik": "+", "suvari": "=" },
    "mizrakci": { "okcu": "=", "kilicli": "-", "mizrakci": "=", "kalkanli": "+", "kesis": "=", "mancinik": "=", "suvari": 2.0 },
    "kalkanli": { "okcu": "=", "kilicli": "=", "mizrakci": "-", "kalkanli": "=", "kesis": "=", "mancinik": "=", "suvari": "+" },
    "mancinik": { "okcu": 1.25, "kilicli": "=", "mizrakci": "=", "kalkanli": "=", "kesis": 1.25, "mancinik": "=", "suvari": 0.5 },
    "suvari":   { "okcu": 1.5, "kilicli": "=", "mizrakci": 0.5, "kalkanli": 0.75, "kesis": 1.5, "mancinik": 1.5, "suvari": "=" }
  }
}
