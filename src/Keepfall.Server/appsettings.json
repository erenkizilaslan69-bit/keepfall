{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Keepfall": {
    // Path to balance.json; empty = search for config/balance.json upward from the content root.
    "BalancePath": "",
    // Dev-only ×5 / ×20 game speed (room host only).
    "AllowSpeedControl": false,
    // Dev-only: a single player may start a match.
    "AllowSoloStart": false,
    // Rooms with nobody connected for this long are dropped.
    "AbandonedRoomMinutes": 10,
    // A player who drops out of the lobby keeps their seat this long.
    "LobbyGraceMinutes": 2,
    // Most rooms (lobbies and matches) at once; 0 = no limit. Measured on a 10%-of-a-core cap (docs/olcum-render.md): 15 rooms in the war keep the 1 s tick (p95 +16 ms),
    // 20 start to slip (p95 +160 ms). Over the limit "Oda kur" and "Hızlı oyna" answer "Sunucu dolu, birazdan tekrar dene."; override with Keepfall__MaxRooms.
    "MaxRooms": 15,
    // The server writes one line a minute about its load (rooms, tick time, memory); 0 = never.
    "StatsLogSeconds": 60
  }
}
