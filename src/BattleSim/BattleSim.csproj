<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Keepfall.Core\Keepfall.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Keepfall.BattleSim</RootNamespace>
  </PropertyGroup>

  <!-- Fallback copy next to the exe; when run inside the repo, config/balance.json is read directly. -->
  <ItemGroup>
    <None Include="..\..\config\balance.json" Link="balance.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
